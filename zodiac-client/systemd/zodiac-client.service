[Unit]
Description=Zodiac telephone client for HomeAI
# The client survives HomeAI being down (it retries), so this only waits for a
# network, not for the server.
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# The Pi runs the whole repo checkout; the client lives in zodiac-client/ and
# has its own venv there (never the repo root's — those are the homeai box's).
WorkingDirectory=/home/pi/dev/homeai-handset/zodiac-client
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/dev/homeai-handset/zodiac-client/.venv/bin/python -m zodiac_client.app --config /home/pi/dev/homeai-handset/zodiac-client/config.yaml
# An appliance restarts. Always.
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

# NOTE: this needs hook.source "gpio" in config.yaml, which is now the shipped
# default. Under systemd there is no terminal, so the "stdin" hook can never
# fire a call — if you switch back to it for bring-up, stop the service first
# or it will fight you for the sound card.
