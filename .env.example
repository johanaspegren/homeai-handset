# Handset service — copy to .env and adjust.

# Where the service listens. The Pi connects to ws://homeai.local:8400/zodiac.
HANDSET_HOST=0.0.0.0
HANDSET_PORT=8400

# The brain. The handset is a channel adapter like Discord and voice: Kiri's
# persona, memory, tools and journal all live behind /chat.
HOMEAI_CHAT_URL=http://localhost:8000/chat
HANDSET_USER=johan
HANDSET_SOURCE=handset

# Speech to text (GPU, same as homeai-voice). int8_float16 shrinks VRAM if
# gemma is resident and the card gets tight.
WHISPER_MODEL=small.en
WHISPER_DEVICE=cuda
#WHISPER_COMPUTE=int8_float16

# Speech out. Voice files are shared with homeai-voice rather than downloaded
# twice; point HOMEAI_VOICE_DIR at that checkout if it isn't the sibling dir.
PIPER_VOICE=en_US-lessac-medium
#HOMEAI_VOICE_DIR=/home/johan/dev/homeai-voice
#PIPER_VOICE_DIR=/home/johan/dev/homeai-voice/voices

# The telephone is the default way in: homeai-voice isn't started with the
# stack, because a muted voice service still VADs every frame and Whispers every
# utterance in the room — mute stops her replying, not the work. Hands free
# starts it on demand (POST :8400/handsfree, or the keypad button below).
HANDSET_HANDSFREE_KEY=*
#HOMEAI_SH=/home/johan/dev/homeai.sh
#HANDSET_HANDSFREE_TIMEOUT_S=45

# When the workshop mic IS running, hold it for the length of a call so she
# doesn't answer the same question twice — once in the earpiece, once out loud.
# Nothing is sent when it isn't running.
HANDSET_MUTES_VOICE=1

# Spoken as the handset is lifted — a fixed line, never a model call, so
# answering never waits on the GPU. Separate several with "|" and one is picked
# per call, never the same one twice running. Empty answers silently.
HANDSET_GREETING=HomeAI. Hello Johan.|Kiri here. Hello Johan.|Hello Johan.|Kiri speaking.

# How long to wait before she starts talking — the time it takes to get the
# handset from the cradle to your ear. Only the greeting waits; the call itself
# opens instantly.
HANDSET_GREETING_DELAY_MS=800

# Turn taking. Hangover is the silence that ends your turn; raise it if it cuts
# you off mid-thought, lower it to shave latency.
VAD_HANGOVER_MS=700
VAD_PREROLL_MS=300
VAD_MIN_SPEECH_MS=250
VAD_MAX_UTTERANCE_MS=20000

LOG_LEVEL=INFO
